{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SemanticDataCharter/sdcdcatus",
  "description": "DCAT-US 3.0 catalogs (data.json) of published Semantic Data Charter models; no account.",
  "repository": {
    "url": "https://github.com/SemanticDataCharter/sdc_dcat3_us",
    "source": "github"
  },
  "version": "4.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "sdcdcatus",
      "version": "4.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the MCP stdio server rather than the CLI."
        }
      ]
    }
  ]
}
